--- !u!114 &495691894
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 495691892}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 85fc4b8de1ee09545884cf226d2b36cd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LoreMenuManager
  loreDatabase:
  - title: "\u0413\u043B\u0430\u0432\u0430 1: \u041F\u0440\u043E\u0431\u0443\u0436\u0434\u0435\u043D\u0438\u0435"
    content: "\u0421\u0438\u0441\u0442\u0435\u043C\u0430 \u0436\u0438\u0437\u043D\u0435\u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D\u0438\u044F
      \u043E\u0442\u043A\u043B\u044E\u0447\u0435\u043D\u0430 \u043F\u0440\u0438\u043D\u0443\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E.
      \u042F \u043E\u0442\u043A\u0440\u044B\u043B \u0433\u043B\u0430\u0437\u0430
      \u0432 \u0440\u0443\u0438\u043D\u0430\u0445 \u0441\u0442\u0430\u0440\u043E\u0433\u043E
      \u0441\u0435\u043A\u0442\u043E\u0440\u0430, \u0433\u0434\u0435 \u0432\u043E\u0437\u0434\u0443\u0445
      \u043F\u0440\u043E\u043F\u0438\u0442\u0430\u043D \u0437\u0430\u043F\u0430\u0445\u043E\u043C
      \u043E\u0437\u043E\u043D\u0430 \u0438 \u043F\u0435\u043F\u043B\u0430. \u0412
      \u043F\u0430\u043C\u044F\u0442\u0438 \u043B\u0438\u0448\u044C \u043E\u0431\u0440\u044B\u0432\u043A\u0438
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0445 \u0434\u043D\u0435\u0439
      \u043F\u0435\u0440\u0435\u0434 \u0442\u0435\u043C, \u043A\u0430\u043A \u043C\u0438\u0440
      \u0440\u0443\u0445\u043D\u0443\u043B, \u0430 \"\u041F\u0440\u043E\u0442\u043E\u043A\u043E\u043B
      \u041F\u0435\u0440\u0435\u0437\u0430\u0433\u0440\u0443\u0437\u043A\u0438\"
      \u0432\u044B\u0436\u0435\u0433 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C.
      \u041C\u043E\u0435 \u043E\u0440\u0443\u0436\u0438\u0435 \u2014 \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
      \u0448\u0430\u043D\u0441 \u043F\u0440\u043E\u0431\u0438\u0442\u044C\u0441\u044F
      \u0441\u043A\u0432\u043E\u0437\u044C \u043C\u0443\u0442\u0438\u0440\u043E\u0432\u0430\u0432\u0448\u0438\u0445
      \u0442\u0432\u0430\u0440\u0435\u0439, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0442\u0435\u043F\u0435\u0440\u044C \u0431\u0440\u043E\u0434\u044F\u0442 \u043F\u043E
      \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0430\u043C. \u041F\u0443\u0442\u0438
      \u043D\u0430\u0437\u0430\u0434 \u043D\u0435\u0442, \u043D\u0443\u0436\u043D\u043E
      \u0438\u0441\u043A\u0430\u0442\u044C \u0432\u044B\u0445\u043E\u0434 \u043D\u0430\u0432\u0435\u0440\u0445."
  - title: "\u0413\u043B\u0430\u0432\u0430 2: \u0421\u0438\u0433\u043D\u0430\u043B
      \u0432\u043E \u0442\u044C\u043C\u0435"
    content: "\u0420\u0430\u0434\u0430\u0440 \u043D\u0430 \u0437\u0430\u043F\u044F\u0441\u0442\u044C\u0435
      \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u043E \u043E\u0436\u0438\u043B.
      \u042F \u043D\u0435 \u043E\u0434\u0438\u043D. \u041D\u0430 \u044D\u0442\u043E\u0439
      \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u043E\u0439 \u0430\u0440\u0435\u043D\u0435
      \u0435\u0441\u0442\u044C \u0434\u0440\u0443\u0433\u0438\u0435 \u0432\u044B\u0436\u0438\u0432\u0448\u0438\u0435,
      \u0438\u0445 \u0431\u0438\u043E\u0441\u0438\u0433\u043D\u0430\u043B\u044B \u0442\u043E
      \u0438 \u0434\u0435\u043B\u043E \u0432\u0441\u043F\u044B\u0445\u0438\u0432\u0430\u044E\u0442
      \u0432 \u0441\u043E\u0441\u0435\u0434\u043D\u0438\u0445 \u043E\u0442\u0441\u0435\u043A\u0430\u0445.
      \u0412 \u044D\u0442\u043E\u043C \u0445\u0430\u043E\u0441\u0435 \u043E\u0434\u0438\u043D\u043E\u0447\u043A\u0438
      \u043F\u043E\u0433\u0438\u0431\u0430\u044E\u0442 \u0431\u044B\u0441\u0442\u0440\u043E,
      \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043D\u0430\u043C \u043F\u0440\u0438\u0434\u0435\u0442\u0441\u044F
      \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u0438\u0442\u044C\u0441\u044F. \u041C\u044B
      \u043D\u0435 \u0437\u043D\u0430\u0435\u043C, \u043C\u043E\u0436\u043D\u043E
      \u043B\u0438 \u0434\u043E\u0432\u0435\u0440\u044F\u0442\u044C \u0434\u0440\u0443\u0433
      \u0434\u0440\u0443\u0433\u0443, \u043D\u043E \u0441\u0435\u0439\u0447\u0430\u0441
      \u043E\u0431\u0449\u0438\u0439 \u0432\u0440\u0430\u0433 \u0434\u0438\u043A\u0442\u0443\u0435\u0442
      \u0441\u0432\u043E\u0438 \u043F\u0440\u0430\u0432\u0438\u043B\u0430: \u043B\u0438\u0431\u043E
      \u043C\u044B \u043F\u0440\u043E\u0440\u0443\u0431\u0430\u0435\u043C \u0441\u0435\u0431\u0435
      \u043F\u0443\u0442\u044C \u0432\u043C\u0435\u0441\u0442\u0435, \u043B\u0438\u0431\u043E
      \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430 \u043E\u0441\u0442\u0430\u043D\u0435\u043C\u0441\u044F
      \u0433\u043D\u0438\u0442\u044C \u0432 \u044D\u0442\u0438\u0445 \u043F\u043E\u0434\u0437\u0435\u043C\u0435\u043B\u044C\u044F\u0445."
  - title: "\u0413\u043B\u0430\u0432\u0430 3: \u0421\u043F\u0443\u0441\u043A \u043A
      \u044F\u0434\u0440\u0443"
    content: "\u0427\u0435\u043C \u0433\u043B\u0443\u0431\u0436\u0435 \u043C\u044B
      \u0441\u043F\u0443\u0441\u043A\u0430\u0435\u043C\u0441\u044F, \u0442\u0435\u043C
      \u044F\u0440\u043E\u0441\u0442\u043D\u0435\u0435 \u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0442\u0441\u044F
      \u0430\u0442\u0430\u043A\u0438. \u0422\u0432\u0430\u0440\u0438 \u0441\u043B\u043E\u0432\u043D\u043E
      \u0437\u0430\u0449\u0438\u0449\u0430\u044E\u0442 \u0447\u0442\u043E-\u0442\u043E
      \u0432\u0430\u0436\u043D\u043E\u0435. \u041C\u043E\u0435 \u0442\u0435\u043B\u043E
      \u0443\u0436\u0435 \u043D\u0430 \u043F\u0440\u0435\u0434\u0435\u043B\u0435,
      \u043D\u043E \u0431\u043E\u043B\u044C \u0440\u043E\u0436\u0434\u0430\u0435\u0442
      \u044F\u0440\u043E\u0441\u0442\u044C, \u0438 \u044F \u043D\u0430\u0443\u0447\u0438\u043B\u0441\u044F
      \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u044C \u044D\u0442\u0443
      \u044D\u043D\u0435\u0440\u0433\u0438\u044E \u0432 \u0441\u0432\u043E\u0438
      \u0443\u0434\u0430\u0440\u044B. \u041C\u044B \u043D\u0430\u0448\u043B\u0438
      \u0441\u0442\u0430\u0440\u044B\u0435 \u0442\u0435\u0440\u043C\u0438\u043D\u0430\u043B\u044B:
      \u0441\u0443\u0434\u044F \u043F\u043E \u043B\u043E\u0433\u0430\u043C, \u043A\u0430\u0442\u0430\u0441\u0442\u0440\u043E\u0444\u0430
      \u043D\u0435 \u0431\u044B\u043B\u0430 \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E\u0441\u0442\u044C\u044E.
      \u041A\u0442\u043E-\u0442\u043E \u043D\u0430\u043C\u0435\u0440\u0435\u043D\u043D\u043E
      \u0430\u043A\u0442\u0438\u0432\u0438\u0440\u043E\u0432\u0430\u043B \u041F\u0440\u043E\u0442\u043E\u043A\u043E\u043B,
      \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u0447\u0438\u0441\u0442\u0438\u0442\u044C
      \u044D\u0442\u043E\u0442 \u043C\u0438\u0440. \u0418 \u044D\u0442\u043E\u0442
      \xAB\u043A\u0442\u043E-\u0442\u043E\xBB \u0432\u0441\u0451 \u0435\u0449\u0451
      \u0436\u0434\u0435\u0442 \u043D\u0430\u0441 \u0432\u043F\u0435\u0440\u0435\u0434\u0438."
  - title: "\u0413\u043B\u0430\u0432\u0430 4: \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
      \u0440\u0443\u0431\u0435\u0436"
    content: "\u041C\u044B \u0434\u043E\u0441\u0442\u0438\u0433\u043B\u0438 \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0433\u043E
      \u0443\u0437\u043B\u0430. \u0412\u043E\u0437\u0434\u0443\u0445 \u0437\u0434\u0435\u0441\u044C
      \u0434\u0440\u043E\u0436\u0438\u0442 \u043E\u0442 \u044D\u043D\u0435\u0440\u0433\u0438\u0438,
      \u0430 \u0432\u043F\u0435\u0440\u0435\u0434\u0438 \u2014 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A
      \u0432\u0441\u0435\u0433\u043E \u044D\u0442\u043E\u0433\u043E \u043A\u043E\u0448\u043C\u0430\u0440\u0430.
      \u042D\u0442\u043E \u0443\u0436\u0435 \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
      \u0431\u0438\u0442\u0432\u0430 \u0437\u0430 \u0432\u044B\u0436\u0438\u0432\u0430\u043D\u0438\u0435,
      \u044D\u0442\u043E \u0448\u0430\u043D\u0441 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
      \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u044B\u0439 \u0446\u0438\u043A\u043B
      \u0441\u043C\u0435\u0440\u0442\u0435\u0439. \u0415\u0441\u043B\u0438 \u043C\u044B
      \u0441\u043C\u043E\u0436\u0435\u043C \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0438\u0442\u044C
      \u0421\u0442\u0440\u0430\u0436\u0430 \u044F\u0434\u0440\u0430, \u0441\u0438\u0441\u0442\u0435\u043C\u0430
      \u0431\u0443\u0434\u0435\u0442 \u043E\u043A\u043E\u043D\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E
      \u0441\u043B\u043E\u043C\u043B\u0435\u043D\u0430. \u041E\u0440\u0443\u0436\u0438\u0435
      \u043D\u0430\u0433\u043E\u0442\u043E\u0432\u0435, \u044F\u0440\u043E\u0441\u0442\u044C
      \u043D\u0430 \u043C\u0430\u043A\u0441\u0438\u043C\u0443\u043C\u0435. \u041F\u043E\u0440\u0430
      \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0442\u044C \u044D\u0442\u0443
      \u0438\u0441\u0442\u043E\u0440\u0438\u044E."
  lorePanel: {fileID: 495691892}
  buttonContainer: {fileID: 1379068113}
  buttonPrefab: {fileID: 6617516076983531732, guid: d91fec674f2b14f458589b769eacda78,
    type: 3}
